{
  "functions": {
    "api/chat.js": {
      "maxDuration": 120,
      "includeFiles": "api/_generate/**/*.json"
    }
  },
  "rewrites": [
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/", "destination": "/app/index.html" }
  ],
  "redirects": [
    { "source": "/", "destination": "/app/", "permanent": false }
  ]
}
