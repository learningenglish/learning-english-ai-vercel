# ============================================================
# MOSAIC English — biến môi trường (khai trên Vercel → Project → Settings → Environment Variables)
# File này CHỈ liệt kê TÊN biến + mô tả. Giá trị thật do chủ sở hữu giữ, không nằm trong bản bàn giao này.
# Sao chép thành ".env.local" khi chạy cục bộ (đừng commit .env.local).
# ============================================================

# ---- Bắt buộc ----
OPENAI_API_KEY=                 # Khóa API OpenAI (sinh bài học, phân tích, chấm viết, TTS)
SUPABASE_SERVICE_ROLE_KEY=      # Khóa service_role của Supabase (server ghi DB bỏ qua RLS) — TỐI MẬT
APP_SECRET=Learning-English-AI  # Header X-App-Secret; PHẢI khớp giá trị nhúng trong app/js/config.js
                               # (không phải bí mật thật — chỉ chặn scrape thô; đổi thì phải đổi cả 2 nơi)

# ---- Ảnh bìa bài học (tùy chọn — thiếu thì bỏ qua bước tìm ảnh) ----
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# ---- Nhà cung cấp AI (tùy chọn — mặc định OpenAI) ----
AI_PROVIDER=openai             # "openai" | "gemini"
OPENAI_MODEL_DEFAULT=          # vd gpt-4o-mini (xem api/_shared/aiProvider.js để biết mặc định)
OPENAI_MODEL_STRONG=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
GEMINI_API_KEY=
GEMINI_MODEL_DEFAULT=
GEMINI_MODEL_STRONG=
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=

# ---- Quản trị ----
ADMIN_EMAILS=                  # Danh sách email admin, phân tách bằng dấu phẩy (server tự kiểm tra lại)

# ---- Thanh toán tự động (chưa nối dịch vụ thật — xem api/webhooks/payment.js) ----
PAYMENT_WEBHOOK_SECRET=        # Chuỗi bí mật đặt trong URL webhook "?token=" của SePay/Casso
PAYMENT_ACCOUNT_NAME=          # Tên chủ tài khoản ngân hàng nhận tiền
PAYMENT_ACCOUNT_NUMBER=        # Số tài khoản ngân hàng
PAYMENT_BANK_CODE=             # Mã ngân hàng (vd ACB)

# ---- Khác ----
CRON_SECRET=                   # Bảo vệ endpoint cron (nếu bật lại tính năng có cron)
